                      // 5. FILTER TARIKH (Guna Obx untuk tukar UI bila tarikh dipilih)
                      Obx(
                        () => GestureDetector(
                          onTap: () => controller.pickDate(context),
                          child: Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 12,
                              vertical: 6,
