                      // --- account balance amount ---
                      Obx(
                        () => Text(
                          controller.merchantBalance.value.toStringAsFixed(2),
                          style: const TextStyle(
                            fontSize: 36,
                            fontWeight: FontWeight.bold,
                            height: 1.0,
                          ),
