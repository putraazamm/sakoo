                  Obx(() {
                    // Tunjuk loading spinner kalau data tengah diambil
                    if (controller.isLoading.value) {
                      return const Center(
                        child: Padding(
                          padding: EdgeInsets.symmetric(vertical: 30.0),
                          child: CircularProgressIndicator(color: Colors.black),
