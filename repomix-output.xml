  String _spendingDayInsight(List<double> pattern, List<String> days) {
    double maxV = 0;
    int maxIdx = 0;
    for (var i = 0; i < pattern.length; i++) {
      if (pattern[i] > maxV) {
        maxV = pattern[i];
        maxIdx = i;
      }
    }
    return 'Most spending happens on ${days[maxIdx]}s';
